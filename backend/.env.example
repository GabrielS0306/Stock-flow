# Conexão da aplicação: pooler do Supabase em modo transaction (porta 6543)
DATABASE_URL="postgresql://postgres.<projeto>:<senha>@aws-1-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão das migrations: pooler em modo session (porta 5432)
DIRECT_URL="postgresql://postgres.<projeto>:<senha>@aws-1-<regiao>.pooler.supabase.com:5432/postgres"

# Segredo usado para assinar os tokens JWT (gere um valor longo e aleatório)
JWT_SECRET="troque-este-valor"
